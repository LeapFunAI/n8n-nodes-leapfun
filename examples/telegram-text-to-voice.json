{
  "name": "Telegram text to voice (LeapFun Turbo)",
  "nodes": [
    {
      "parameters": { "updates": ["message"] },
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "resource": "speech",
        "operation": "generate",
        "text": "={{ $json.message.text }}",
        "engine": "turbo",
        "voiceSource": "preset",
        "voice": { "__rl": true, "mode": "id", "value": "af_heart" },
        "options": { "format": "mp3" }
      },
      "name": "LeapFun",
      "type": "n8n-nodes-leapfun.leapFun",
      "typeVersion": 1,
      "position": [260, 0],
      "credentials": { "leapFunApi": { "id": "", "name": "LeapFun API" } }
    },
    {
      "parameters": {
        "operation": "sendAudio",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": { "caption": "={{ $json.creditsUsed }} credits" }
      },
      "name": "Send voice",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [520, 0]
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "LeapFun", "type": "main", "index": 0 }]] },
    "LeapFun": { "main": [[{ "node": "Send voice", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
