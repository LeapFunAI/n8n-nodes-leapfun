{
  "name": "n8n-nodes-leapfun",
  "version": "0.1.0",
  "description": "n8n community node for LeapFun AI text-to-speech: four engine tiers, director's notes, 100+ voices, shared credits with your LeapFun workspace.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "text-to-speech",
    "tts",
    "voice",
    "audio",
    "leapfun"
  ],
  "license": "MIT",
  "homepage": "https://leapfun.ai/developers/n8n/",
  "author": {
    "name": "LeapFun AI",
    "email": "support@leapfun.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeapFunAI/n8n-nodes-leapfun.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/LeapFunAI/n8n-nodes-leapfun/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/LeapFunApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LeapFun/LeapFun.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.53.3",
    "eslint": "9.32.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
